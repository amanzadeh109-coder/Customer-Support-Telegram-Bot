    {
      "parameters": {
        "jsCode": "const reply = $input.first().json;\nconst telegram = $('Telegram Trigger').first().json;\n\nlet category = 'fallback';\n\ntry {\n  const parsed = JSON.parse(reply.message?.content ?? '');\n  if (telegram.message?.text?.trim() && ['billing', 'technical', 'general'].includes(parsed.category)) {\n    category = parsed.category;\n  }\n} catch (error) {\n  // Invalid AI output goes to the fallback branch.\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    user: telegram.message?.from?.first_name ?? 'Unknown',\n    chat_id: telegram.message?.chat?.id,\n    original_message: telegram.message?.text ?? '',\n    category\n  }\n}];"
      },
